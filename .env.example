# Copy to .env and fill in. Never commit the real .env.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=erp.example.com
CORS_ALLOWED_ORIGINS=https://erp.example.com
DJANGO_TIME_ZONE=Africa/Cairo

POSTGRES_DB=okasha_erp
POSTGRES_USER=okasha
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

MEDIA_ROOT=/data/media
BACKUP_DIR=/data/backups
BACKUP_KEEP_DAYS=30
MAX_UPLOAD_MB=25

# WhatsApp and SMS providers are not chosen yet; these log messages instead of sending.
WHATSAPP_BACKEND=erp.core.notifications.LogBackend
SMS_BACKEND=erp.core.notifications.LogBackend
